# Django secret key (сгенерируйте свой)
SECRET_KEY=django-insecure-1234567890abcdefghijklmnopqrstuvwxyz

# Debug mode
DEBUG=True

# Allowed hosts (через запятую)
ALLOWED_HOSTS=127.0.0.1,localhost

# Google OAuth (для входа через django-allauth)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google OAuth2 (для Google Calendar API)
GOOGLE_OAUTH2_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-client-secret

# Email settings (для продакшена)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# CSRF settings (для продакшена установите True)
CSRF_COOKIE_SECURE=False

# ---------- НОВОЕ: токен для EasyCron ----------
CRON_TOKEN=zioSf1QjkTCcDhHH2C7EM0dr9jJj0hmrWbB_E9IOnHM

# ---------- НОВОЕ: VAPID ключи для Web Push ----------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ---------- НОВОЕ: Firebase (FCM) ----------
FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json

# ---------- НОВОЕ: Максимум задач в день для адаптивного планировщика ----------
MAX_TASKS_PER_DAY=5

ACCOUNT_EMAIL_VERIFICATION=mandatory